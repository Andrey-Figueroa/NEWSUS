{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/main/index.html"
    },
    {
      "source": "/styles.css",
      "destination": "/main/styles.min.css"
    },
    {
      "source": "/styles.min.css",
      "destination": "/main/styles.min.css"
    },
    {
      "source": "/script.js",
      "destination": "/main/script.min.js"
    },
    {
      "source": "/script.min.js",
      "destination": "/main/script.min.js"
    }
  ],
  "redirects": [
    {
      "source": "/system",
      "destination": "/system/login/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(css|js|webp|png|jpg|jpeg|svg|ico|woff2|woff)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
